classDiagram
    direction TB

    class Wire {
        -string name_
        -bool value_
        +get() bool
        +set(bool v)
    }

    class Component {
        <<abstract>>
        -string name_
        +name() string
        +collectGates(gates)*
        +gateCount() size_t
    }

    class Gate {
        <<abstract>>
        #Wire* a_
        #Wire* b_
        #Wire* out_
        -bool next_
        +compute() bool*
        +evaluate()
        +commit() bool
        +out() Wire*
    }

    class NandGate { +compute() bool }
    class NorGate { +compute() bool }

    class Circuit {
        -vector~unique_ptr~Component~~ parts_
        -vector~unique_ptr~Wire~~ wires_
        #add~T~(args) T*
        #newWire(name, init) Wire*
        +collectGates(gates)
    }

    class LogicBlock {
        #Wire* out_
        +out() Wire*
    }

    class NotGate
    class AndGate
    class OrGate
    class XorGate
    class XnorGate
    class NotNorGate
    class AndNorGate
    class OrNorGate
    class XorNorGate

    class HalfAdder { +sum() Wire* ; +carry() Wire* }
    class FullAdder { +sum() Wire* ; +cout() Wire* }
    class RippleCarryAdder { +sum() vector ; +cout() Wire* }
    class DLatch { +q() Wire* ; +qn() Wire* }
    class DFlipFlop { +q() Wire* }
    class Buffer
    class Counter4 { +q(bit) Wire* }

    class Simulator {
        -vector~Gate*~ gates_
        -size_t threads_
        +addProbe(label, wire)
        +addBus(label, wires)
        +set(wire, value)
        +settle() int
        +record()
        +tickClock(clk)
        +result() SimulationResult
    }

    class SimulationResult {
        -vector~string~ names_
        -vector~Row~ rows_
        +addRow(time, values)
        +columns()
        +rows()
    }

    class Output {
        +write(result)
    }
    class CSVOutput {
        -string path_
        +write(result)
    }

    Component <|-- Gate
    Component <|-- Circuit
    Gate <|-- NandGate
    Gate <|-- NorGate
    Circuit <|-- LogicBlock
    LogicBlock <|-- NotGate
    LogicBlock <|-- AndGate
    LogicBlock <|-- OrGate
    LogicBlock <|-- XorGate
    LogicBlock <|-- XnorGate
    LogicBlock <|-- NotNorGate
    LogicBlock <|-- AndNorGate
    LogicBlock <|-- OrNorGate
    LogicBlock <|-- XorNorGate
    Circuit <|-- HalfAdder
    Circuit <|-- FullAdder
    Circuit <|-- RippleCarryAdder
    Circuit <|-- DLatch
    Circuit <|-- DFlipFlop
    Circuit <|-- Buffer
    Circuit <|-- Counter4

    Circuit *-- Component : owns parts
    Circuit *-- Wire : owns internal wires
    Gate --> Wire : reads a, b / drives out
    Simulator --> Component : flattens
    Simulator --> Gate : evaluate / commit
    Simulator *-- SimulationResult : records into
    Output ..> SimulationResult : reads
    Output <|-- CSVOutput
